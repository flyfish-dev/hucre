+  if (!ref) return ""
+  const first = ctx.sheetNames?.[ref.firstSheet]
+  const last = ctx.sheetNames?.[ref.lastSheet]
+  if (!first) return ""
+  if (last && last !== first) return `${quoteSheetName(first)}:${quoteSheetName(last)}!`
+  return `${quoteSheetName(first)}!`
+}
